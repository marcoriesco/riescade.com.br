# Stripe Environment Variables
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_ENDPOINT_URL=

# Next Auth
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Private Instagram studio: /admin/instagram (all values server-only).
# Supabase Auth user UUIDs, separated by commas. Empty = nobody can administer.
SOCIAL_ADMIN_USER_IDS=
# Instagram product credentials from Meta, not the Facebook Login credentials.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=
INSTAGRAM_EXPECTED_USERNAME=riescade
# Generate independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_CRON_SECRET=
# Enable only after migration, OAuth connection, deployment and scheduler setup.
INSTAGRAM_PUBLISHING_ENABLED=false

# Supabase Environment Variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key
SUPABASE_SERVICE_ROLE_KEY=

# Pilot access and rate limiting (server only)
# Comma-separated Supabase user UUIDs allowed without an active subscription.
DOWNLOAD_TEST_USER_IDS=
# Enable only after applying/testing the friends migration in development.
RIESCADE_FRIENDS_ENABLED=false
DOWNLOAD_REQUESTS_PER_MINUTE=10
ROMSET_UPDATE_REQUESTS_PER_MINUTE=2000
PLATFORM_DOWNLOAD_REQUESTS_PER_MINUTE=2000

# Google Drive downloads (server only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep literal \n characters when configuring this value on Vercel.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Required when the folders are inside a Google Workspace shared drive.
GOOGLE_SHARED_DRIVE_ID=
# Releases folder where Criar-Release.ps1 uploads RIESCADE-RetroBat-<version>.7z.
GOOGLE_RELEASES_FOLDER_ID=
# Long random secret used only by the private catalog sync endpoint.
GOOGLE_DRIVE_SYNC_SECRET=

# Desktop application release publishing (server only)
# Long random bearer secret accepted by /api/internal/releases/publish.
RELEASE_PUBLISH_SECRET=
# Ed25519 public key matching the private release-signing key. Literal \n is supported.
RIESCADE_UPDATE_PUBLIC_KEY=

# Private NES/FCEUmm rooms (server only). Independent secrets >=32 characters.
